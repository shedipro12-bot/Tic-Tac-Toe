{
  "name": "tic-tac-toe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/verify-pwa.mjs && node scripts/verify-hosting.mjs",
    "preview": "node scripts/static-server.mjs --port 4173",
    "test:e2e": "npm run test:updates:prepare && playwright test",
    "test:updates:prepare": "npm run typecheck && node scripts/prepare-update-tests.mjs"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
